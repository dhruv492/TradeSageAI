# Copy this file to .env and fill in real values. Never commit the real .env
# (it's already covered by .gitignore).

# --- Actually read by backend/app.py today ---
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///tradesage.db
# For PostgreSQL (target deployment): postgresql://user:password@host:5432/tradesage

# --- Reserved for live data sources (NOT wired into code yet) ---
# price_service.py / sentiment_service.py currently take their fetchers as
# injected function arguments (see smoke_test_full.py) rather than reading
# these directly - that's intentional, it's what keeps them testable without
# live network access. These are placeholders for whenever real credentials
# get plumbed through:
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tradesage-ai/0.1
BINANCE_API_KEY=
BINANCE_API_SECRET=
